# Copia este archivo como .env y ajusta los valores.
# .env NO se sube al repositorio (esta en .gitignore).

# Base de datos PostgreSQL/TimescaleDB.
# La BD "goont" se crea sola en el primer arranque si no existe.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/goont?sslmode=disable
# Ejemplo con la BD corriendo como contenedor en la misma red docker:
# DATABASE_URL=postgres://usuario:clave@postgres-timescale:5432/goont?sslmode=disable

# Direccion de escucha del servidor API (run-server usa --network host).
GOONT_ADDR=0.0.0.0:8080

# SNMP: conexiones simultaneas por OLT.
GOONT_SNMP_CONNS=10
# OLTs escaneandose en paralelo durante 'ont scan'.
GOONT_MAX_OLTS=32

# Escaneo: timeout (segundos) y reintentos por consulta SNMP. Los valores por
# OLT solo se usan si son menores; un OLT con 60 s no debe frenar el ciclo.
GOONT_SCAN_TIMEOUT=15
GOONT_SCAN_RETRIES=2
# Deadline del ciclo de escaneo (segundos). Con el cron cada 15 min, 780
# (13 min) deja 2 min de margen; el default del codigo es 270 (cron de 5 min).
GOONT_SCAN_DEADLINE=780

# Pool de conexiones del servidor API (los escaneos de la CLI usan 3).
GOONT_DB_MAX_CONNS=10

# Cache en memoria de respuestas JSON. GOONT_CACHE_TTL=0 la desactiva.
GOONT_CACHE_TTL=60
GOONT_CACHE_MB=64
