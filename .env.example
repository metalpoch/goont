# Copia este archivo como .env y ajusta los valores.
# .env NO se sube al repositorio (esta en .gitignore).

# Base de datos PostgreSQL/TimescaleDB.
# La BD "goont" se crea sola en el primer arranque si no existe.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/goont?sslmode=disable
# Ejemplo con la BD corriendo como contenedor en la misma red docker:
# DATABASE_URL=postgres://usuario:clave@postgres-timescale:5432/goont?sslmode=disable

# Direccion de escucha del servidor API (run-server usa --network host).
GOONT_ADDR=0.0.0.0:8080

# SNMP: conexiones simultaneas por OLT.
GOONT_SNMP_CONNS=10
# OLTs escaneandose en paralelo durante 'ont scan'.
GOONT_MAX_OLTS=32
